# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# PHP form ayarları (gizli anahtar içerir)
public/api/config.php

# build öncesi üretilen duyarlı görsel sürümleri (scripts/generate-responsive-images.mjs)
/public/_img/

# Hosting yükleme paketi (out/ klasöründen üretilir)
/akcy-site.zip
