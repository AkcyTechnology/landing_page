# ============================================================
# AKCY — ortam değişkenleri örneği
# Bu dosyayı ".env.local" adıyla kopyalayıp değeri doldurun.
# Değer "npm run build" sırasında sitenin HTML'ine gömülür.
# ============================================================

# Cloudflare Turnstile → "Site Key" (herkese açık anahtar).
# Boşsa robot doğrulama kutusu gösterilmez.
# Yerel test için her zaman geçen test anahtarı: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Gizli anahtar ve mail ayarları: public/api/config.php
# (örnek: public/api/config.example.php)

# Google Search Console → "HTML etiketi" doğrulama yöntemindeki content değeri.
# Boşsa etiket üretilmez. (DNS ile doğruladıysanız gerek yoktur.)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 → Yönetici > Veri akışları > "Ölçüm Kimliği" (G-XXXXXXXXXX).
# Boşsa ne çerez bandı ne de Analytics yüklenir. Doluysa Analytics yalnızca
# ziyaretçi çerez bandında "Kabul et" dedikten sonra çalışır.
NEXT_PUBLIC_GA_ID=

# Bing Webmaster Tools → "msvalidate.01" meta etiketindeki content değeri.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Microsoft Clarity → Settings > Overview > "Project ID" (ör. abcd1234ef).
# Isı haritası ve oturum kayıtları; yalnızca çerez onayı verilirse yüklenir.
NEXT_PUBLIC_CLARITY_ID=

# Ücretsiz keşif görüşmesi randevu adresi (Cal.com, Calendly vb.).
# Boşsa teklif ve iletişim sayfalarında randevu bağlantısı gösterilmez.
NEXT_PUBLIC_BOOKING_URL=
