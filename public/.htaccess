# ============================================================
# AKCY — Turhost (cPanel / Apache) ayarları
# "npm run build" ile out/ klasörüne kopyalanır; public_html'e yüklenir.
# ============================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
# İngilizce sayfalarda bulunamayan adresler için İngilizce 404 sayfası
<If "%{REQUEST_URI} =~ m#^/en(/|$)#">
  ErrorDocument 404 /en/404/index.html
</If>

# --- Gizli dosyalar: tarayıcıdan erişilemez --------------------------
<FilesMatch "^(config\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # SSL sertifikasının otomatik yenilenmesi (cPanel AutoSSL) için
  # .well-known klasörü yönlendirmelerin dışında tutulur.
  RewriteRule ^\.well-known/ - [L]

  # Tek adres: www'lu adresler www'suz adrese yönlenir (HTTPS ile birlikte,
  # tek adımda): www.akcy.com.tr/blog/ → https://akcy.com.tr/blog/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Her zaman HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Eski hizmet detay adresleri artık tek Hizmetler sayfasındaki karta gider
  # (kalıcı yönlendirme; arama motorları eski adresin değerini yeni sayfaya aktarır):
  # /hizmetler/web-gelistirme/ → /hizmetler/#web-gelistirme
  RewriteRule ^hizmetler/([^/]+)/?$ /hizmetler/#$1 [NE,L,R=301]
  RewriteRule ^en/services/([^/]+)/?$ /en/services/#$1 [NE,L,R=301]

  # Sayfalar klasör olarak üretilir; "/" olmadan gelen istekler kalıcı
  # olarak "/" ile biten adrese yönlendirilir: /iletisim → /iletisim/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# --- Güvenlik başlıkları ---------------------------------------------
<IfModule mod_headers.c>
  # Tarayıcının dosya türünü tahmin edip zararlı içerik çalıştırmasını engeller
  Header always set X-Content-Type-Options "nosniff"
  # Sitenin başka sitelerde iframe içine alınmasını (clickjacking) engeller
  Header always set X-Frame-Options "SAMEORIGIN"
  # Başka sitelere giderken tam adresin sızmasını önler
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Kullanılmayan kamera / mikrofon / konum izinlerini kapatır
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  # Tarayıcıyı siteye her zaman HTTPS ile bağlanmaya zorlar
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  # Başka sekmelerin bu pencereye window.opener ile erişmesini engeller
  # (dış bağlantılar zaten noopener ile açılıyor; WhatsApp/Turnstile etkilenmez)
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Temkinli CSP: script kaynaklarını kısıtlamaz (Next.js satır içi betikleri,
  # Turnstile, Analytics çalışmaya devam eder). Yalnızca eklenti/nesne
  # gömmeyi, <base> etiketi ile adres değiştirmeyi, formların başka sitelere
  # gönderilmesini ve sitenin başka sitelerde çerçeve içine alınmasını engeller.
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# --- Önbellek: sürüm adlı dosyalar uzun süre, sayfalar her seferinde ---
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# /_next/static/ altındaki dosyaların adında içerik özeti (hash) bulunur;
# içerik değişince adı da değişir. Bu yüzden 1 yıl, "immutable" önbelleklenir.
<If "%{REQUEST_URI} =~ m#^/_next/static/#">
  Header set Cache-Control "public, max-age=31536000, immutable"
</If>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# Web manifest için doğru MIME türü (bazı Apache kurulumlarında tanımlı değildir)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
