# ============================================================
# AKCY — ortam değişkenleri örneği
# Bu dosyayı ".env.local" adıyla kopyalayıp değeri doldurun.
# Değer "npm run build" sırasında sitenin HTML'ine gömülür.
# ============================================================

# Cloudflare Turnstile → "Site Key" (herkese açık anahtar).
# Boşsa robot doğrulama kutusu gösterilmez.
# Yerel test için her zaman geçen test anahtarı: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Gizli anahtar ve mail ayarları: public/api/config.php
# (örnek: public/api/config.example.php)
